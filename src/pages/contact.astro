---
// contact: a postcard. note on the left, address lines on the right.
import Base from '../layouts/Base.astro';
import site from '../../content/site.json';
---
<Base title="contact" description={`get in touch with ${site.name}: email, linkedin, and x.`}>
  <section class="contact wrap" aria-labelledby="contact-h">
    <h1 id="contact-h">say hi</h1>

    <article class="card" aria-label="postcard">
      <div class="card__note">
        <p class="card__dear">hey!</p>
        <p>to know more about me, feel free to shoot me a message ❤️</p>
        <p class="card__sign">— josie</p>
      </div>

      <div class="card__back">
        <ul class="lines">
          <li>
            <span class="lines__label">email</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          {site.links.map((l) => (
            <li>
              <span class="lines__label">{l.label}</span>
              <a href={l.href} target="_blank" rel="noopener">{l.handle} ↗</a>
            </li>
          ))}
        </ul>
      </div>
    </article>
  </section>
</Base>

<style>
  .contact { padding-top: clamp(2rem, 6vw, 4rem); }
  .contact h1 { font-size: clamp(3rem, 2rem + 4vw, 5rem); line-height: 1; margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }

  /* the postcard */
  .card {
    display: grid;
    max-width: 860px;
    background: #fffdf8;
    border: 1px solid color-mix(in srgb, var(--sky) 40%, var(--ink-muted));
    box-shadow: 0 1px 2px rgb(30 36 51 / 0.06), 0 22px 40px -28px rgb(30 36 51 / 0.45);
    rotate: -0.6deg;
  }
  @media (min-width: 720px) { .card { grid-template-columns: 1fr 1fr; min-height: 380px; } }

  .card__note, .card__back { padding: clamp(1.4rem, 4vw, 2.4rem); }
  .card__note { display: flex; flex-direction: column; gap: 0.8rem; font-size: var(--step-1); line-height: 1.5; }
  .card__dear { font-family: var(--font-name); font-style: italic; color: var(--ink-muted); }
  .card__sign { margin-top: auto; font-family: var(--font-name); font-style: italic; }

  /* divider line down the middle, like the back of a real postcard */
  .card__back { display: flex; flex-direction: column; gap: 1.6rem; border-top: 1px dashed var(--rule); }
  @media (min-width: 720px) { .card__back { border-top: 0; border-left: 1px solid var(--rule); } }

  /* address lines */
  .lines { display: grid; gap: 0; margin-top: auto; padding: 0; list-style: none; }
  .lines li { display: grid; gap: 0.1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--rule); }
  .lines__label { font-family: var(--font-pixel); font-size: 0.72rem; color: var(--ink-muted); }
  .lines a { font-size: var(--step-1); color: var(--ink); text-decoration-color: var(--sky); overflow-wrap: anywhere; }
  .lines a:hover { color: var(--blue-ink); text-decoration-color: currentColor; }
</style>
