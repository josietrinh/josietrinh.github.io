---
// lore: the story beside a polaroid and what i'm up to, then the year's playlist.
import Base from '../layouts/Base.astro';
import site from '../../content/site.json';
import about from '../../content/about.json';
---
<Base title="lore" description={`lore of ${site.name}: ${site.bio.text}.`}>
  <div class="about wrap">
    <h1 class="sr-only">lore</h1>

    <section class="intro" aria-label="intro">
      <div class="intro__text">
        <p class="intro__lead">{about.lead}</p>
        {about.blurb.map((p) => <p>{p}</p>)}
        <ul class="hobbies">
          {about.hobbies.map((h) => <li set:html={h} />)}
        </ul>
        <blockquote class="more">
          <p>{about.moreLore.label}</p>
          <ul>
            {about.moreLore.items.map((m) => <li>{m}</li>)}
          </ul>
        </blockquote>
      </div>
      <figure class="snap">
        <img src={about.photo.src} alt={about.photo.alt} decoding="async" />
      </figure>
      <section class="sec intro__now" aria-labelledby="now-h">
        <h2 id="now-h">currently</h2>
        <dl class="now">
          {about.currently.map((c) => (
            <div><dt>{c.label}</dt><dd>{c.text}</dd></div>
          ))}
        </dl>
      </section>
    </section>

    <section class="sec exp" aria-labelledby="exp-h">
      <h2 id="exp-h">{about.experience.label}</h2>
      <ul class="exp__list">
        {about.experience.main.map((e) => {
          const Row = e.href ? 'a' : 'div';
          return (
            <li>
              <Row class="exp__row" href={e.href}>
                <img class="exp__logo" src={e.logo} alt="" width="40" height="40" loading="lazy" decoding="async" />
                <span class="exp__name">{e.company} <span class="exp__role">/ {e.role}</span></span>
                <span class="exp__years">{e.years}</span>
              </Row>
            </li>
          );
        })}
      </ul>

      <h3 class="exp__sub">{about.experience.sideQuestsLabel}</h3>
      <ul class="exp__list exp__list--side">
        {about.experience.sideQuests.map((e) => (
          <li>
            <div class="exp__row">
              <img class="exp__logo" src={e.logo} alt="" width="40" height="40" loading="lazy" decoding="async" />
              <span class="exp__name">{e.company} <span class="exp__role">/ {e.role}</span></span>
              <span class="exp__years">{e.years}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <figure class="playlist">
      <iframe
        src="https://open.spotify.com/embed/playlist/5q1lfRztNOCESZaFEgePSH?utm_source=generator"
        title="my 2026 playlist on spotify"
        width="100%"
        height="352"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        allowfullscreen
      ></iframe>
      <figcaption>my 2026, in melodies</figcaption>
    </figure>
  </div>
</Base>

<style>
  .about { max-width: calc(820px + 2 * var(--gutter)); padding-top: clamp(2rem, 6vw, 4rem); }
  .about p { max-width: none; }

  /* bio left, photo right; on phones the photo leads */
  .intro { display: grid; gap: 2.2rem clamp(2rem, 6vw, 4rem); align-items: center; }
  .intro__text { min-width: 0; }
  .intro .intro__now { margin-top: 0; } /* the grid gap spaces it */
  .intro .snap { order: -1; }
  @media (min-width: 720px) {
    /* two equal columns that end on the same line: the photo takes up whatever currently leaves */
    .intro { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 1fr auto; align-items: stretch; }
    .intro__text { grid-row: 1 / span 2; }
    .intro .snap { order: 0; position: relative; width: 100%; min-height: 300px; }
    .intro .snap img { position: absolute; inset: 10px 10px 32px; width: calc(100% - 20px); height: calc(100% - 42px); aspect-ratio: auto; }
    .intro__now { grid-column: 2; }
  }

  /* the polaroid; the crop centres on josie in the landscape photo */
  .snap {
    width: min(100%, 300px);
    margin: 0;
    padding: 10px 10px 32px;
    background: var(--white);
    box-shadow: 0 1px 2px rgb(30 36 51 / 0.08), 0 20px 32px -20px rgb(30 36 51 / 0.45);
    rotate: -1.5deg;
    transition: rotate 0.35s var(--ease), translate 0.35s var(--ease);
  }
  .snap:hover { rotate: 0deg; translate: 0 -4px; }
  .snap img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 54% 50%; }

  .intro p { font-size: var(--step-0); line-height: 1.75; }
  .intro__text p + p { margin-top: 1rem; }
  .intro__lead { font-family: var(--font-name); font-style: italic; font-size: var(--step-1) !important; line-height: 1.4 !important; }
  .hobbies { margin: 0.6rem 0 0; padding-left: 1.2rem; line-height: 1.6; }
  .hobbies li + li { margin-top: 0.2rem; }

  /* the aside: smaller, quieter, set off like a quote */
  .more { margin: 1.5rem 0 0; padding-left: 1rem; border-left: 2px solid var(--rule); color: var(--ink-soft); }
  .more p { font-size: var(--step--1); line-height: 1.5; font-style: italic; }
  .more ul { margin: 0.3rem 0 0; padding-left: 1.1rem; font-size: var(--step--1); line-height: 1.5; }
  .more li + li { margin-top: 0.2rem; }

  .sec { margin-top: clamp(2.8rem, 7vw, 4rem); }
  .sec > h2 { font-family: var(--font-name); font-style: italic; font-weight: 400; font-size: var(--step-1); margin-bottom: 0.6rem; }

  .now { display: grid; margin: 0; }
  .now div { display: grid; gap: 0.1rem 1.4rem; padding: 0.55rem 0; }
  .now div + div { border-top: 1px dashed var(--rule); }
  @media (min-width: 480px) and (max-width: 719px) { .now div { grid-template-columns: 7rem 1fr; } }
  .now dt { font-family: var(--font-name); font-style: italic; color: var(--ink-muted); }
  .now dd { margin: 0; }

  /* experience: logo, company / role, years; quiet rules between rows */
  .exp__list { list-style: none; margin: 0; padding: 0; }
  .exp__list li + li { border-top: 1px solid var(--rule); }
  .exp__row {
    display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: 1rem;
    padding: 0.85rem 0; color: var(--ink); text-decoration: none;
  }
  .exp__logo { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; background: var(--white); box-shadow: 0 0 0 1px var(--rule); }
  .exp__name { font-size: var(--step-0); line-height: 1.35; min-width: 0; }
  .exp__role { color: var(--ink-muted); }
  .exp__years { font-variant-numeric: tabular-nums; color: var(--ink-muted); white-space: nowrap; font-size: var(--step--1); }
  a.exp__row .exp__logo { transition: rotate 0.35s var(--ease), translate 0.35s var(--ease); }
  a.exp__row:hover .exp__logo, a.exp__row:focus-visible .exp__logo { rotate: -6deg; translate: 0 -2px; }
  a.exp__row:hover .exp__name { text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 3px; }
  .exp__sub { margin: 2rem 0 0.4rem; font-family: var(--font-name); font-style: italic; font-weight: 400; font-size: var(--step-0); color: var(--ink-soft); }
  .exp__list--side .exp__row { padding: 0.7rem 0; }
  .exp__list--side .exp__logo { width: 32px; height: 32px; border-radius: 8px; justify-self: center; }
  @media (max-width: 479px) {
    .exp__row { grid-template-columns: 40px 1fr; row-gap: 0.15rem; }
    .exp__years { grid-column: 2; }
  }

  .playlist { margin: clamp(3.5rem, 9vw, 5.5rem) 0 0; text-align: center; }
  .playlist iframe { display: block; border: 0; border-radius: 12px; }
  .playlist figcaption { margin-top: 0.8rem; font-family: var(--font-name); font-style: italic; font-size: var(--step-1); color: var(--ink-soft); }
</style>
