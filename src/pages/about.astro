---
// about: one quiet column. a few small polaroids, the blurb, experience, what i'm up to, then the year's playlist.
import Base from '../layouts/Base.astro';
import site from '../../content/site.json';
import about from '../../content/about.json';
import { svg } from '../lib/motifs';

const tilts = [-6, 3, -2];
const motifs = ['sparkle', 'waves', 'stars'];
---
<Base title="about" description={`about ${site.name}: ${site.bio.text}.`}>
  <div class="about wrap">
    <h1 class="sr-only">about</h1>

    <div class="snaps">
      {about.photos.map((ph, i) => (
        <figure class="snap" style={`--tilt:${tilts[i % tilts.length]}deg`}>
          {ph.src
            ? <img src={ph.src} alt={ph.alt} loading="lazy" decoding="async" />
            : <div class="snap__blank" role="img" aria-label={ph.alt}><span>{ph.alt}</span></div>}
        </figure>
      ))}
    </div>

    <section class="intro" aria-label="intro">
      <p class="intro__lead">{site.bio.text}.</p>
      {about.blurb.map((p) => <p>{p}</p>)}
    </section>

    <section class="sec" aria-labelledby="exp-h">
      <h2 id="exp-h">experience</h2>
      <ol class="exp">
        {site.work.map((w, i) => (
          <li>
            <a href={`/work/${w.slug}/`}>
              <span class="exp__mark" aria-hidden="true" set:html={svg(motifs[i % motifs.length])} />
              <span class="exp__role"><strong>{w.company}</strong> / {w.role}</span>
              <span class="exp__dates">{w.dates}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec" aria-labelledby="now-h">
      <h2 id="now-h">currently</h2>
      <dl class="now">
        {about.currently.map((c) => (
          <div><dt>{c.label}</dt><dd>{c.text}</dd></div>
        ))}
      </dl>
    </section>

    <figure class="playlist">
      <iframe
        src="https://open.spotify.com/embed/playlist/5q1lfRztNOCESZaFEgePSH?utm_source=generator"
        title="my 2026 playlist on spotify"
        width="100%"
        height="352"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        allowfullscreen
      ></iframe>
      <figcaption>my 2026, in the form of notes and strings</figcaption>
    </figure>
  </div>
</Base>

<style>
  .about { max-width: calc(560px + 2 * var(--gutter)); padding-top: clamp(2rem, 6vw, 4rem); }
  .about p { max-width: none; }

  /* a little fan of small polaroids, like keepsakes on a desk */
  .snaps { display: flex; padding-left: 0.4rem; }
  .snap {
    width: 104px;
    margin: 0;
    padding: 6px 6px 16px;
    background: var(--white);
    box-shadow: 0 1px 2px rgb(30 36 51 / 0.08), 0 12px 20px -14px rgb(30 36 51 / 0.45);
    rotate: var(--tilt);
    transition: rotate 0.35s var(--ease), translate 0.35s var(--ease);
  }
  .snap + .snap { margin-left: -14px; }
  .snap:hover { rotate: 0deg; translate: 0 -4px; z-index: 1; }
  .snap img, .snap__blank { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .snap__blank { display: grid; place-items: center; padding: 0.3rem; background: rgb(214 228 245 / 0.55); text-align: center; }
  .snap__blank span { font-size: 0.6rem; line-height: 1.3; color: var(--ink-muted); }

  .intro { margin-top: 2rem; }
  .intro p { font-size: var(--step-0); line-height: 1.75; }
  .intro p + p { margin-top: 1rem; }
  .intro__lead { font-family: var(--font-name); font-style: italic; font-size: var(--step-1) !important; line-height: 1.4 !important; }

  .sec { margin-top: clamp(2.8rem, 7vw, 4rem); }
  .sec > h2 { font-family: var(--font-name); font-style: italic; font-weight: 400; font-size: var(--step-1); margin-bottom: 0.6rem; }

  /* experience: mark, company / role, dates */
  .exp { padding: 0; list-style: none; }
  .exp a { display: grid; grid-template-columns: 2.2rem 1fr auto; align-items: center; gap: 0.9rem; padding: 0.8rem 0.2rem; border-bottom: 1px solid var(--rule); color: var(--ink); text-decoration: none; transition: background 0.2s; }
  .exp li:last-child a { border-bottom: 0; }
  .exp a:hover { background: rgb(214 228 245 / 0.35); }
  .exp__mark { display: block; width: 2.2rem; aspect-ratio: 1; padding: 3px; background: #dcd6ec; }
  .exp__mark :global(svg) { display: block; width: 100%; height: 100%; background: #a7b495; }
  .exp__mark :global(.m) { fill: #dcd6ec; stroke: #dcd6ec; }
  .exp__role { line-height: 1.35; color: var(--ink-muted); }
  .exp__role strong { font-weight: 700; color: var(--ink); }
  .exp__dates { color: var(--ink-muted); font-size: var(--step--1); white-space: nowrap; }
  @media (max-width: 479px) {
    .exp a { grid-template-columns: 2.2rem 1fr; }
    .exp__dates { grid-column: 2; margin-top: -0.6rem; }
  }

  .now { display: grid; margin: 0; }
  .now div { display: grid; gap: 0.1rem 1.4rem; padding: 0.55rem 0; }
  .now div + div { border-top: 1px dashed var(--rule); }
  @media (min-width: 480px) { .now div { grid-template-columns: 7rem 1fr; } }
  .now dt { font-family: var(--font-name); font-style: italic; color: var(--ink-muted); }
  .now dd { margin: 0; }

  .playlist { margin: clamp(3.5rem, 9vw, 5.5rem) 0 0; text-align: center; }
  .playlist iframe { display: block; border: 0; border-radius: 12px; }
  .playlist figcaption { margin-top: 0.8rem; font-family: var(--font-name); font-style: italic; font-size: var(--step-1); color: var(--ink-soft); }
</style>
