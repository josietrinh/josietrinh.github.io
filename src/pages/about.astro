---
// about: the blurb + polaroids, then experience, tech stack, and what i'm up to currently.
import Base from '../layouts/Base.astro';
import Tape from '../components/Tape.astro';
import site from '../../content/site.json';
import about from '../../content/about.json';

const tilts = [-3, 2.5, -1.5];
const tapes = ['lilac', 'butter', 'sky'] as const;
// lowercase to match the site's voice, but keep acronyms like G4A
const lower = (s: string) => s.split(' ').map((w) => (/^[A-Z0-9]{2,}$/.test(w) ? w : w.toLowerCase())).join(' ');
---
<Base title="about" description={`about ${site.name}: ${site.bio.text}.`}>
  <div class="about wrap">
    <section class="intro" aria-labelledby="about-h">
      <div class="intro__text">
        <h1 id="about-h">about</h1>
        <p class="intro__lead">{site.bio.text}.</p>
        {about.blurb.map((p) => <p>{p}</p>)}
      </div>

      <div class="snaps">
        {about.photos.map((ph, i) => (
          <figure class="snap" style={`--tilt:${tilts[i % tilts.length]}deg`}>
            <Tape color={tapes[i % tapes.length]} pattern="dots" rotate={i % 2 ? -5 : 4} style="top:-12px;left:calc(50% - 46px)" />
            {ph.src
              ? <img src={ph.src} alt={ph.alt} loading="lazy" decoding="async" />
              : <div class="snap__blank" role="img" aria-label={ph.alt}><span>{ph.alt}</span></div>}
            {ph.caption && <figcaption>{ph.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>

    <section class="sec" aria-labelledby="exp-h">
      <h2 id="exp-h">experience</h2>
      <ol class="exp">
        {site.work.map((w) => (
          <li>
            <a href={`/work/${w.slug}/`}>
              <span class="exp__role"><strong>{w.role}</strong> @ {w.company}</span>
              <span class="exp__dates">{w.dates}</span>
              <span class="exp__focus">{w.focus}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec" aria-labelledby="stack-h">
      <h2 id="stack-h">tech stack</h2>
      <div class="stack">
        {site.techStack.map((g) => (
          <div>
            <p class="stack__label">{g.group}</p>
            <ul class="chips">{g.tools.map((t) => <li>{lower(t)}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="sec" aria-labelledby="now-h">
      <h2 id="now-h">currently</h2>
      <dl class="now">
        {about.currently.map((c) => (
          <div><dt>{c.label}</dt><dd>{c.text}</dd></div>
        ))}
      </dl>
    </section>
  </div>
</Base>

<style>
  .about { padding-top: clamp(1.5rem, 5vw, 3rem); }

  .intro { display: grid; gap: clamp(2.5rem, 6vw, 4rem); align-items: start; }
  @media (min-width: 860px) { .intro { grid-template-columns: 1.1fr 1fr; } }
  .intro h1 { font-size: clamp(3rem, 2rem + 4vw, 5rem); line-height: 1; margin-bottom: 1.4rem; }
  .intro__text p { font-size: var(--step-0); line-height: 1.75; }
  .intro__text p + p { margin-top: 1rem; }
  .intro__lead { font-family: var(--font-name); font-style: italic; font-size: var(--step-1) !important; line-height: 1.45 !important; }

  /* polaroids: a loose, overlapping stack */
  .snaps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem 1rem; padding-top: 0.8rem; }
  .snap {
    position: relative;
    margin: 0;
    padding: 9px 9px 0;
    background: var(--white);
    box-shadow: 0 1px 2px rgb(30 36 51 / 0.08), 0 16px 26px -18px rgb(30 36 51 / 0.45);
    rotate: var(--tilt);
    transition: rotate 0.35s var(--ease), translate 0.35s var(--ease);
  }
  .snap:nth-child(3) { grid-column: 1 / -1; width: 58%; justify-self: center; margin-top: -0.6rem; }
  .snap:hover { rotate: 0deg; translate: 0 -3px; }
  .snap img, .snap__blank { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .snap__blank { display: grid; place-items: center; padding: 0.8rem; background: rgb(214 228 245 / 0.55); text-align: center; }
  .snap__blank span { font-size: 0.82rem; line-height: 1.35; color: var(--ink-muted); }
  .snap figcaption { padding: 0.5rem 0.2rem 0.7rem; font-family: var(--font-name); font-style: italic; font-size: 1rem; line-height: 1.2; text-align: center; color: var(--ink-soft); }
  .snap:not(:has(figcaption)) { padding-bottom: 2rem; }

  .sec { margin-top: clamp(3.5rem, 8vw, 5rem); }
  .sec > h2 { display: flex; align-items: center; gap: 0.9rem; font-size: var(--step-2); margin-bottom: 1.3rem; }
  .sec > h2::after { content: ''; flex: 1; height: 1px; background: var(--rule); }

  .exp { padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .exp a { display: grid; gap: 0.15rem 1.5rem; padding: 1rem 0.2rem; border-bottom: 1px solid var(--rule); color: var(--ink); text-decoration: none; transition: background 0.2s; }
  @media (min-width: 720px) { .exp a { grid-template-columns: 1fr auto; } .exp__focus { grid-column: 1 / -1; } }
  .exp a:hover { background: rgb(214 228 245 / 0.35); }
  .exp__role { font-size: var(--step-1); }
  .exp__role strong { font-weight: 700; }
  .exp__dates { color: var(--ink-muted); font-size: var(--step--1); }
  .exp__focus { color: var(--ink-soft); font-size: 0.98rem; }

  .stack { display: grid; gap: 1.6rem 2.5rem; }
  @media (min-width: 640px) { .stack { grid-template-columns: 1fr 1fr; } }
  .stack__label { margin-bottom: 0.6rem; font-family: var(--font-name); font-style: italic; font-size: 1.1rem; color: var(--ink-muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; list-style: none; }
  .chips li { padding: 0.15rem 0.65rem; background: rgb(255 253 249 / 0.7); border: 1px solid color-mix(in srgb, var(--sky) 50%, var(--ink-muted)); border-radius: 999px; font-size: 0.95rem; }

  .now { display: grid; margin: 0; padding: clamp(1rem, 3vw, 1.6rem); background: #fffdf8; border: 1px solid var(--rule); max-width: 640px; rotate: -0.4deg; }
  .now div { display: grid; gap: 0.1rem 1.4rem; padding: 0.6rem 0; }
  .now div + div { border-top: 1px dashed var(--rule); }
  @media (min-width: 560px) { .now div { grid-template-columns: 8rem 1fr; } }
  .now dt { font-family: var(--font-name); font-style: italic; color: var(--ink-muted); }
  .now dd { margin: 0; }
</style>
