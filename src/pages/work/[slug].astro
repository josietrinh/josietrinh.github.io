---
// a case study: at a glance → overview → selected work → campaign index → learnings → skills & tools.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import { svg } from '../../lib/motifs';

export async function getStaticPaths() {
  const all = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null, index: i + 1 },
  }));
}

const { entry, prev, next, index } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
// lets a project's text carry [markdown links](https://...)
const links = (s: string) => s.replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
---
<Base title={d.company} description={`${d.company}: ${d.focus}. a case study by josie trinh.`} texture="soft">
  <div class="cs wrap">
    <nav class="toc" aria-label="on this page">
      <a class="toc__back" href="/#work">← all work</a>
      <p class="toc__title">on this page</p>
      <ol>
        <li><a href="#glance">at a glance</a></li>
        <li><a href="#overview">overview</a></li>
        <li>
          <a href="#selected">selected work</a>
          <ol>
            {d.projects.map((p) => <li><a href={`#${slug(p.title)}`}>{p.title}</a></li>)}
          </ol>
        </li>
        {d.campaigns.length > 0 && <li><a href="#campaigns">campaign index</a></li>}
        {d.learnings.length > 0 && <li><a href="#learnings">learnings</a></li>}
        <li><a href="#skills">skills & tools</a></li>
      </ol>
    </nav>

    <article class="article">
      <header class="head">
        <a class="head__back" href="/#work">← all work</a>
        <p class="head__label">case study {String(index).padStart(2, '0')}</p>
        <h1>{d.company}</h1>
        <p class="head__role"><strong>{d.role}</strong><span>{d.dates}</span></p>
      </header>

      <div class="cover">
        {d.cover?.src
          ? <PhotoSlot src={d.cover.src} alt={d.cover.alt} ratio={d.cover.ratio ?? '16 / 9'} eager />
          : <div class="cover__tile" role="img" aria-label={d.cover?.alt ?? 'cover image placeholder'}>
              <span class="cover__art" set:html={svg(d.motif)} />
              <span class="cover__todo">[TODO: cover image]</span>
            </div>}
      </div>

      <section class="sec" id="glance" aria-labelledby="glance-h">
        <h2 id="glance-h">at a glance</h2>
        <dl class="glance">
          {d.glance.map((g) => (
            <div><dt>{g.label}</dt><dd>{g.value}</dd></div>
          ))}
        </dl>
      </section>

      <section class="sec" id="overview" aria-labelledby="overview-h">
        <h2 id="overview-h">overview</h2>
        <div class="prose"><Content /></div>
      </section>

      <section class="sec" id="selected" aria-labelledby="selected-h">
        <h2 id="selected-h">selected work</h2>
        {d.projects.map((p, i) => (
          <article class="proj" id={slug(p.title)} aria-labelledby={`${slug(p.title)}-h`}>
            <p class="proj__n">{String(i + 1).padStart(2, '0')}</p>
            <h3 id={`${slug(p.title)}-h`}>{p.title}</h3>
            {p.scope && <p class="proj__scope">{p.scope}</p>}

            {p.problem && (<div class="proj__block"><p class="proj__label">{p.problemLabel}</p><p set:html={links(p.problem)} /></div>)}
            {p.approach && (<div class="proj__block"><p class="proj__label">{p.approachLabel}</p><p>{p.approach}</p></div>)}

            {p.points.length > 0 && (
              <div class="proj__block">
                {p.pointsLabel && <p class="proj__label">{p.pointsLabel}</p>}
                <ul class="proj__points">
                  {p.points.map((pt) => <li>{pt.label && <strong>{pt.label}{pt.text && ': '}</strong>}{pt.text}</li>)}
                </ul>
              </div>
            )}

            {p.outcome && (
              <p class="proj__outcome"><span>outcome</span>{p.outcome}</p>
            )}
            {p.link && (
              <p class="proj__link"><a href={p.link.href} target="_blank" rel="noopener">{p.link.text} ↗</a>{p.link.note && <span> · {p.link.note}</span>}</p>
            )}
            {p.links.map((l) => (
              <p class="proj__link"><a href={l.href} target="_blank" rel="noopener">{l.text} ↗</a></p>
            ))}

            {p.photos.length > 0 && (
              <div class:list={['proj__photos', { 'proj__photos--one': p.photos.length === 1 }]}>
                {p.photos.map((ph) => <PhotoSlot src={ph.src} alt={ph.alt} caption={ph.caption} ratio={ph.ratio} poster={ph.poster} link={ph.link} />)}
              </div>
            )}
            {p.contactForMore && <p class="proj__more">→ <a href="/contact/">reach out</a> for more information!</p>}
            {p.confidential && <p class="proj__more">project assets are confidential, <a href="/contact/">reach out</a> for more information!</p>}
          </article>
        ))}
      </section>

      {d.campaigns.length > 0 && (
        <section class="sec" id="campaigns" aria-labelledby="campaigns-h">
          <h2 id="campaigns-h">campaign index</h2>
          <ol class="camps">
            {d.campaigns.map((c) => (
              <li class="camp">
                <div class="camp__head">
                  <h3>{c.name}</h3>
                  <p class="camp__period">{c.period}</p>
                </div>
                <p class="camp__summary">{c.summary}</p>
                {c.assets.length > 0 && (
                  <div class:list={['camp__assets', { 'camp__assets--one': c.assets.length === 1 }]}>
                    {c.assets.map((a) => <PhotoSlot src={a.src} alt={a.alt} caption={a.caption} ratio={a.ratio} poster={a.poster} link={a.link} />)}
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}

      {d.learnings.length > 0 && (
        <section class="sec" id="learnings" aria-labelledby="learnings-h">
          <h2 id="learnings-h">learnings</h2>
          <ol class="learn">
            {d.learnings.map((l, i) => (
              <li>
                <p class="learn__n">{String(i + 1).padStart(2, '0')}</p>
                <h3>{l.title}</h3>
                <p>{l.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section class="sec" id="skills" aria-labelledby="skills-h">
        <h2 id="skills-h">skills & tools</h2>
        <div class="kit">
          <div>
            <p class="kit__label">core skills</p>
            <ul class="chips">{d.skills.map((s) => <li>{s}</li>)}</ul>
          </div>
          <div>
            <p class="kit__label">tools</p>
            <ul class="chips">{d.tools.map((s) => <li>{s}</li>)}</ul>
          </div>
        </div>
      </section>

      <nav class="pager" aria-label="more case studies">
        {prev ? <a class="pager__item" href={`/work/${prev.id}/`}><span>← previous</span><strong>{prev.data.company}</strong></a> : <span />}
        {next ? <a class="pager__item pager__item--next" href={`/work/${next.id}/`}><span>next →</span><strong>{next.data.company}</strong></a> : <a class="pager__item pager__item--next" href="/#work"><span>back to</span><strong>all work</strong></a>}
      </nav>
    </article>
  </div>
</Base>

<style>
  .cs { display: grid; gap: 2rem; padding-top: clamp(1.5rem, 4vw, 3rem); }
  @media (min-width: 1100px) { .cs { grid-template-columns: 210px minmax(0, 1fr); gap: 4rem; } }

  /* sticky table of contents (wide screens only) */
  .toc { display: none; }
  @media (min-width: 1100px) {
    .toc { display: block; position: sticky; top: 1.5rem; align-self: start; font-size: 0.98rem; }
  }
  .toc__back, .head__back { display: inline-block; margin-bottom: 1.4rem; color: var(--ink-muted); text-decoration: none; }
  .toc__back:hover, .head__back:hover { color: var(--blue-ink); }
  @media (min-width: 1100px) { .head__back { display: none; } }
  .toc__title { margin-bottom: 0.5rem; font-family: var(--font-name); font-style: italic; color: var(--ink-muted); }
  .toc ol { padding: 0; list-style: none; display: grid; gap: 0.35rem; }
  .toc ol ol { margin: 0.35rem 0 0.2rem; padding-left: 0.8rem; border-left: 1px solid var(--rule); font-size: 0.92rem; }
  .toc a { color: var(--ink-soft); text-decoration: none; line-height: 1.3; }
  .toc a:hover { color: var(--blue-ink); }

  .article { max-width: 760px; min-width: 0; }
  .article p { max-width: none; }

  /* header */
  .head__label { font-family: var(--font-pixel); font-size: 0.8rem; letter-spacing: 0.04em; color: var(--ink-muted); }
  .head h1 { margin-top: 0.3rem; font-size: clamp(3rem, 2rem + 4vw, 5.2rem); line-height: 0.95; }
  .head__role { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 1rem; margin-top: 0.9rem; max-width: none; font-size: var(--step-1); }
  .head__role strong { font-weight: 700; }
  .head__role span { color: var(--ink-muted); font-size: var(--step-0); }

  /* cover: a photo, or a woodcut banner until there is one */
  .cover { margin-top: 2rem; }
  .cover__tile {
    position: relative;
    display: block;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: #a7b495;
    --tile-paper: #dcd6ec;
  }
  .cover__art { position: absolute; inset: 0; }
  .cover__art :global(svg) { width: 100%; height: 100%; }
  .cover__art :global(.m) { fill: #dcd6ec; stroke: #dcd6ec; }
  .cover__todo {
    position: absolute;
    right: 0.8rem;
    bottom: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: rgb(255 253 249 / 0.85);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  /* sections */
  .sec { margin-top: clamp(3rem, 7vw, 4.5rem); scroll-margin-top: 1.5rem; }
  .sec > h2 {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: var(--step-2);
    margin-bottom: 1.3rem;
  }
  .sec > h2::after { content: ''; flex: 1; height: 1px; background: var(--rule); }

  .glance { display: grid; margin: 0; border-top: 1px solid var(--rule); }
  .glance div { display: grid; gap: 0.1rem 1.5rem; padding: 0.7rem 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 640px) { .glance div { grid-template-columns: 9rem 1fr; } }
  .glance dt { font-family: var(--font-name); font-style: italic; color: var(--ink-muted); }
  .glance dd { margin: 0; }

  /* markdown paragraphs miss .article p's reset, so the overview needs its own to reach the rule */
  .prose { font-size: var(--step-0); line-height: 1.7; }
  .prose :global(p) { max-width: none; }
  .prose :global(p + p) { margin-top: 1rem; }

  /* each project */
  .proj { position: relative; padding-top: 2rem; scroll-margin-top: 1.5rem; }
  .proj + .proj { margin-top: 2.6rem; border-top: 1px dashed var(--rule); }
  .proj__n { font-family: var(--font-pixel); font-size: 0.78rem; color: var(--blue-ink); }
  .proj h3 { margin-top: 0.2rem; font-size: var(--step-2); }
  .proj__scope { margin-top: 0.5rem; font-style: italic; color: var(--ink-soft); font-size: var(--step-0); }
  .proj__block { margin-top: 1.1rem; }
  .proj__label { margin-bottom: 0.2rem; font-family: var(--font-name); font-style: italic; font-size: 1.1rem; color: var(--ink-muted); }
  .proj__block p:not(.proj__label) { line-height: 1.7; }
  .proj__block p a { color: var(--blue-ink); }
  .proj__points { margin-top: 1.1rem; padding-left: 1.2rem; display: grid; gap: 0.55rem; line-height: 1.6; }
  .proj__points li::marker { content: '✦  '; color: var(--sky-deep); font-size: 0.8em; }
  .proj__points strong { font-weight: 700; }
  .proj__outcome {
    margin-top: 1.3rem;
    padding: 0.7rem 1rem;
    background: rgb(214 228 245 / 0.55);
    border-left: 3px solid var(--sky-deep);
    line-height: 1.55;
  }
  .proj__outcome span { display: block; font-family: var(--font-name); font-style: italic; font-size: 1.05rem; color: var(--ink-muted); }
  .proj__link { margin-top: 1rem; }
  .proj__link a { color: var(--blue-ink); }
  .proj__more { margin-top: 1.2rem; font-style: italic; color: var(--ink-muted); }
  .proj__more a { color: var(--blue-ink); }
  .proj__photos { display: grid; gap: 1rem; margin-top: 1.6rem; }
  @media (min-width: 560px) { .proj__photos { grid-template-columns: 1fr 1fr; } .proj__photos--one { grid-template-columns: 1fr; } }

  .proj__link span { color: var(--ink-muted); }

  /* campaign index: one card per campaign, its assets underneath */
  .camps { display: grid; gap: 1.6rem; padding: 0; list-style: none; }
  .camp { padding: 1.2rem; background: rgb(255 253 249 / 0.6); border: 1px solid var(--rule); }
  .camp__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 1rem; }
  .camp h3 { font-size: var(--step-1); }
  .camp__period { font-family: var(--font-pixel); font-size: 0.78rem; color: var(--blue-ink); }
  .camp__summary { margin-top: 0.4rem; line-height: 1.6; color: var(--ink-soft); }
  .camp__assets { display: grid; gap: 1rem; margin-top: 1.1rem; }
  @media (min-width: 640px) { .camp__assets { grid-template-columns: 1fr 1fr; align-items: start; } }
  .camp__assets--one { grid-template-columns: minmax(0, 400px) !important; }

  /* learnings: numbered notes */
  .learn { display: grid; gap: 1.4rem; padding: 0; list-style: none; }
  .learn li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.15rem 0.6rem; }
  .learn__n { grid-row: span 2; padding-top: 0.35rem; font-family: var(--font-pixel); font-size: 0.78rem; color: var(--blue-ink); }
  .learn h3 { font-size: var(--step-1); }
  .learn p:not(.learn__n) { line-height: 1.7; color: var(--ink-soft); }

  /* skills + tools */
  .kit { display: grid; gap: 1.6rem; }
  @media (min-width: 640px) { .kit { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  .kit__label { margin-bottom: 0.6rem; font-family: var(--font-name); font-style: italic; color: var(--ink-muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; list-style: none; }
  .chips li { padding: 0.15rem 0.65rem; background: rgb(255 253 249 / 0.7); border: 1px solid color-mix(in srgb, var(--sky) 50%, var(--ink-muted)); border-radius: 999px; font-size: 0.95rem; }

  /* prev / next */
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: clamp(3.5rem, 8vw, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .pager__item { display: grid; gap: 0.1rem; color: var(--ink); text-decoration: none; }
  .pager__item span { font-size: 0.92rem; color: var(--ink-muted); }
  .pager__item strong { font-family: var(--font-name); font-style: italic; font-weight: 400; font-size: var(--step-1); }
  .pager__item:hover strong { color: var(--blue-ink); }
  .pager__item--next { text-align: right; }
</style>
