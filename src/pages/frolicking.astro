---
// frolicking: on pause until the october recap is ready. the pinboard + media log content still lives in content/.
import Base from '../layouts/Base.astro';
---
<Base title="frolicking" description="hobbies, fun projects, and a monthly log of what josie trinh is reading, watching, and listening to.">
  <div class="fro wrap">
    <header class="head">
      <h1>frolicking</h1>
      <p class="head__sub">comeback later for my october recap ; )</p>
    </header>
  </div>
</Base>

<style>
  .fro { padding-top: clamp(1.5rem, 5vw, 3rem); }
  .head h1 { font-size: clamp(3rem, 2rem + 4vw, 5rem); line-height: 1; }
  .head__sub { margin-top: 0.6rem; color: var(--ink-soft); font-size: var(--step-1); }
</style>
