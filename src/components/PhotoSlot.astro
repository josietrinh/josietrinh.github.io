---
// a photo or short clip, or a clearly marked empty frame until one is added.
import { isVideo } from '../lib/media';
interface Props {
  src?: string;
  alt: string;
  caption?: string;
  ratio?: string;
  eager?: boolean;
}
const { src = '', alt, caption, ratio = '4 / 3', eager = false } = Astro.props;
---
<figure class="slot" style={`--ratio:${ratio}`}>
  {src && isVideo(src)
    ? <video src={src} aria-label={alt} autoplay muted loop playsinline controls preload="metadata" />
    : src
    ? <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <div class="slot__empty" role="img" aria-label={alt}><span>{alt}</span></div>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .slot { margin: 0; }
  .slot img, .slot video, .slot__empty {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    background: var(--white);
  }
  .slot img, .slot video { box-shadow: 0 1px 2px rgb(30 36 51 / 0.08), 0 10px 22px -16px rgb(30 36 51 / 0.35); }
  .slot__empty {
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgb(255 253 249 / 0.6);
    border: 1px dashed color-mix(in srgb, var(--sky) 45%, var(--ink-muted));
    text-align: center;
  }
  .slot__empty span { max-width: 28ch; font-size: 0.9rem; line-height: 1.4; color: var(--ink-muted); }
  .slot figcaption { margin-top: 0.4rem; font-size: 0.9rem; font-style: italic; color: var(--ink-muted); }
</style>
