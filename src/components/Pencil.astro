---
// a loose pencil outline around its parent (parent needs position: relative).
interface Props {
  shape?: 'oval' | 'rect' | 'loop';
  inset?: string;
}
const { shape = 'rect', inset } = Astro.props;
const paths = {
  // overshoots its start, like a quick hand-drawn line
  rect: 'M6 4 C 60 1, 140 3, 196 5 C 198 30, 197 70, 195 96 C 140 98, 60 99, 4 97 C 2 70, 3 30, 5 2 L 40 3',
  oval: 'M100 3 C 160 2, 199 22, 198 50 C 197 80, 150 98, 100 97 C 45 96, 2 80, 3 50 C 4 22, 40 4, 108 5 C 140 7, 170 14, 182 24',
  loop: 'M30 6 C 80 0, 170 2, 194 30 C 202 62, 160 96, 96 96 C 30 96, 0 70, 6 40 C 10 18, 40 6, 70 5',
};
---
<svg class="pencil" viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true" style={inset ? `--pi:${inset}` : undefined}>
  <path d={paths[shape]} />
</svg>
