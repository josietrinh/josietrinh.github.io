---
// a small label saying what something is. used to mark mock / self-initiated work.
interface Props {
  text: string;
  color?: 'blush' | 'peach' | 'butter' | 'pistachio' | 'sky' | 'lilac';
}
const { text, color = 'butter' } = Astro.props;
---
<span class="tag" style={`--tag-color:var(--${color})`}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0 C 12.8 7.6, 16.4 11.2, 24 12 C 16.4 12.8, 12.8 16.4, 12 24 C 11.2 16.4, 7.6 12.8, 0 12 C 7.6 11.2, 11.2 7.6, 12 0 Z" fill="var(--rose)" /></svg>
  {text}
</span>
